# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://sanatix.net
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ─── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Agents (see docs/06-Autonomous-Agents.md) ───────────────
# Generate with: openssl rand -base64 32
# Set the SAME value in Vercel's project env vars — Vercel then sends it
# automatically as "Authorization: Bearer <value>" on every cron-triggered
# request, which the cron routes check. Without it, the routes still work
# but are unauthenticated (anyone with the URL could trigger a paid agent
# run) — the routes log a warning if it's missing.
CRON_SECRET=

# ─── Payments ───────────────────────────────────────────────
# No payment provider is live yet — bookings/contributions only ever
# reach status "pending", nothing charges a card (see src/lib/payments).
# Lite (lite.sa) is the provider being pursued; LiteProvider throws until
# this is set. The HyperPay/Stripe vars this file used to list were never
# actually wired into any code path — removed so this file doesn't imply
# otherwise. Left as a single var since Lite's real credential shape
# (one key vs. key+secret, sandbox vs. live) isn't known yet.
LITE_API_KEY=

# ─── Comms ──────────────────────────────────────────────────
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ─── Analytics ──────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Maps ───────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ─── Error tracking (Sentry) ─────────────────────────────────
# Free tier at sentry.io is enough to start. See APPLY-sentry-web.md for
# the full setup walkthrough. Leave NEXT_PUBLIC_SENTRY_DSN blank and
# Sentry simply never activates — no errors, no build failures.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Only needed in CI/Vercel builds, to upload readable source maps — never
# required for the app to run or for errors to be captured.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
