# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://sanatix.net
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ─── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Agents (see docs/06-Autonomous-Agents.md) ───────────────
# Generate with: openssl rand -base64 32
# Set the SAME value in Vercel's project env vars — Vercel then sends it
# automatically as "Authorization: Bearer <value>" on every cron-triggered
# request, which the cron routes check. Without it, the routes still work
# but are unauthenticated (anyone with the URL could trigger a paid agent
# run) — the routes log a warning if it's missing.
CRON_SECRET=

# ─── Payments ───────────────────────────────────────────────
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Comms ──────────────────────────────────────────────────
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ─── Analytics ──────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Maps ───────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
