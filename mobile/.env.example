# Same Supabase project the web app uses — find these in Supabase
# dashboard → Project Settings → API. Never commit the real .env file.
EXPO_PUBLIC_SUPABASE_URL=https://fobrdnjicooekbrknojo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Used to build RSVP share links (same production domain as the web app)
EXPO_PUBLIC_SITE_URL=https://sanatix.net

# Error tracking (Sentry). Free tier at sentry.io is enough to start — see
# APPLY-sentry-mobile.md. Leave blank and Sentry never activates: no
# crashes reported, no extra native code paths taken.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
