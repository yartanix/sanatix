{
  "expo": {
    "name": "Sanatix",
    "slug": "sanatix",
    "scheme": "sanatix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F0F14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a722fefa-cc08-465d-a364-6c06fb0767a5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.sanatix.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Sanatix uses your contacts so you can pick who to invite to a party. Nothing is uploaded except the names and numbers of people you choose to invite.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "net.sanatix.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F14"
      },
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Sanatix to access your contacts so you can pick who to invite to a party."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "yartanix",
          "project": "sanatix-mobile"
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C8973A"
        }
      ],
      "./plugins/withPodfilePostInstall",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a722fefa-cc08-465d-a364-6c06fb0767a5"
      }
    }
  }
}
