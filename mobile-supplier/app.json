{
  "expo": {
    "name": "Sanatix Supplier",
    "slug": "sanatix-supplier",
    "scheme": "sanatix-supplier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F0F14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.sanatix.supplier",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "net.sanatix.supplier",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F14"
      }
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C8973A"
        }
      ],
      "./plugins/withPodfilePostInstall",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d9441a5d-4d39-4251-97c9-59c25bb0cfc2"
      }
    },
    "owner": "yartanix"
  }
}
